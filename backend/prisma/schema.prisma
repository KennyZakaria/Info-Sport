generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  password            String
  role                String   @default("player") // "admin" or "player"
  position            String   @default("Milieu") // "Gardien", "Défenseur", "Milieu", "Attaquant"
  rating              Int      @default(50)
  mustChangePassword  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  participants Participant[]
  notations   Notation[]
  votes       ManOfMatchVote[]

  @@map("users")
}

model Match {
  id            String   @id @default(uuid())
  date          DateTime
  location      String   @default("Terrain Principal")
  format        Int      @default(6) // 6v6
  status        String   @default("planifié") // "planifié", "terminé", "annulé"
  adminNote     String?
  generalRating Int      @default(0)
  teamAName     String?
  teamBName     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants Participant[]
  manOfMatchVotes ManOfMatchVote[]

  @@map("matches")
}

model Participant {
  id             String   @id @default(uuid())
  status         String   @default("présent") // "présent", "absent", "en_attente"
  team           String?  // "A", "B", or null
  goals          Int      @default(0)
  goalsConfirmed Boolean  @default(false)
  rating         Int      @default(0) // note par joueur pour ce match, sur 10
  note           String?
  evaluated      Boolean  @default(false)

  userId         String
  matchId        String
  user           User     @relation(fields: [userId], references: [id])
  match          Match    @relation(fields: [matchId], references: [id])

  notations      Notation[]
  votesReceived  ManOfMatchVote[]

  @@unique([userId, matchId])

  @@map("participants")
}

model Notation {
  id             String   @id @default(uuid())
  rating         Int?     // note donnée par l'admin (0-10)
  comment        String?  // commentaire privé visible uniquement par l'admin
  adminId        String   // utilisateur admin qui a créé la notation
  participantId  String   @unique // une seule note par joueur/match
  admin          User     @relation(fields: [adminId], references: [id])
  participant    Participant @relation(fields: [participantId], references: [id])
  createdAt      DateTime @default(now())

  @@map("notations")
}

model ManOfMatchVote {
  id                String   @id @default(uuid())
  matchId           String
  voterId           String   // utilisateur qui vote (joueur)
  votedParticipantId String  // participant élu homme du match
  createdAt         DateTime @default(now())

  match             Match    @relation(fields: [matchId], references: [id])
  voter             User     @relation(fields: [voterId], references: [id])
  votedParticipant  Participant @relation(fields: [votedParticipantId], references: [id])

  @@unique([voterId, matchId])
  @@map("man_of_match_votes")
}
